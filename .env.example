PORT=3000
MONGO_URL=

# Довільний рядок для генерації підпису токена
JWT_SECRET=your_random_secret_string

# Домен фронтенда, на який буде вести посилання в листі
# Наприклад http://localhost:3001
FRONTEND_DOMAIN=http://localhost:3001

# Значення беремо із акаунта Brevo (або SendGrid)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Пошта, на яку реєстрували акаунт brevo.com
SMTP_FROM=

# Значення беремо із акаунта Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=